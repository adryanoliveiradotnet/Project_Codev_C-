<Page x:Class="Codev_V2.Páginas.PaginaIncial"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:Codev_V2.Páginas"
      xmlns:hc="https://handyorg.github.io/handycontrol"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      mc:Ignorable="d"
      d:DesignHeight="620" d:DesignWidth="800"
      Background="#212328"
      Title="PaginaIncial" Loaded="Page_Loaded">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="20"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Cabeçalho -->
        <StackPanel Grid.Row="0">
            <TextBlock Text="Página Inicial" FontSize="22" FontWeight="Bold" Foreground="#E0E1E6"/>
            <TextBlock Text="Clientes cadastrados recentemente" FontSize="13" Foreground="#6B6C6F" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- Lista de Cards -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl x:Name="CardsContainer">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border CornerRadius="10" Margin="0,0,12,12"
                                Width="230" Padding="16" Cursor="Hand"
                                BorderThickness="1">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="#2A2D34"/>
                                    <Setter Property="BorderBrush" Value="#393C44"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="BorderBrush" Value="#2A7AFF"/>
                                            <Setter Property="Background" Value="#393C44"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="8"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="4"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="12"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Ícone + ID -->
                                <StackPanel Grid.Row="0" Orientation="Horizontal">
                                    <Border Width="32" Height="32" CornerRadius="16" Background="#1A2A7AFF">
                                        <materialDesign:PackIcon Kind="AccountCircle" Width="18" Height="18"
                                                                  Foreground="#2A7AFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="{Binding IdFormatado}" FontSize="11" Foreground="#6B6C6F"
                                               VerticalAlignment="Center" Margin="8,0,0,0"/>
                                </StackPanel>

                                <!-- Nome -->
                                <TextBlock Grid.Row="2" Text="{Binding Cliente}" FontSize="15" FontWeight="SemiBold"
                                           Foreground="#E0E1E6" TextTrimming="CharacterEllipsis"/>

                                <!-- Bairro -->
                                <StackPanel Grid.Row="4" Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="MapMarker" Width="14" Height="14"
                                                              Foreground="#6B6C6F" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                    <TextBlock Text="{Binding Bairro}" FontSize="12" Foreground="#6B6C6F"
                                               TextTrimming="CharacterEllipsis"/>
                                </StackPanel>

                                <!-- Endereço + Número -->
                                <Border Grid.Row="6" Background="#212328" CornerRadius="6" Padding="10,6">
                                    <TextBlock Text="{Binding EnderecoCompleto}" FontSize="11" Foreground="#A0A1A6"
                                               TextTrimming="CharacterEllipsis"/>
                                </Border>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Mensagem quando vazio -->
        <StackPanel x:Name="EmptyState" Grid.Row="2" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed">
            <materialDesign:PackIcon Kind="AccountGroupOutline" Width="48" Height="48" Foreground="#393C44" HorizontalAlignment="Center"/>
            <TextBlock Text="Nenhum cliente cadastrado ainda" FontSize="14" Foreground="#6B6C6F" HorizontalAlignment="Center" Margin="0,10,0,0"/>
        </StackPanel>
    </Grid>
</Page>
