<Application x:Class="Codev_V2.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Codev_V2"
             StartupUri="Splash.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <!-- Data GRID -->
            <Style TargetType="DataGridCell">
                <Setter Property="Background" Value="#212328"/>
                <Setter Property="Foreground" Value="#E0E1E6"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Style.Triggers>
                    <Trigger Property="IsSelected" Value="True">
                        <Setter Property="Background" Value="#2A7AFF"/>
                        <Setter Property="Foreground" Value="White"/>
                    </Trigger>
                </Style.Triggers>
            </Style>
            <Style TargetType="DataGrid">
    <Setter Property="Background" Value="#212328"/>
    <Setter Property="Foreground" Value="#E0E1E6"/>
    <Setter Property="BorderBrush" Value="#393C44"/>
    <Setter Property="RowBackground" Value="#212328"/>
    <Setter Property="AlternatingRowBackground" Value="#2A2D34"/>
    <Setter Property="GridLinesVisibility" Value="None"/>
    <Setter Property="HorizontalGridLinesBrush" Value="#393C44"/>
    <Setter Property="VerticalGridLinesBrush" Value="#393C44"/>
    <Setter Property="HorizontalContentAlignment" Value="Right"/>
</Style>
<Style TargetType="DataGridColumnHeader">
        <Setter Property="Background" Value="#2A2D34"/>
        <Setter Property="Foreground" Value="#E0E1E6"/>
        <Setter Property="BorderBrush" Value="#393C44"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
            <Style TargetType="DataGridRow">
                <Setter Property="Background" Value="#212328"/>
                <Setter Property="Foreground" Value="#E0E1E6"/>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="#2A2D34"/>
                    </Trigger>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="#2A2D34"/>
                    </Trigger>
                    <Trigger Property="IsSelected" Value="True">
                        <Setter Property="Background" Value="#393C44"/>
                        <Setter Property="Foreground" Value="White"/>
                    </Trigger>
                </Style.Triggers>
            </Style>
            <!-- Group BOX -->
            <Style TargetType="GroupBox">
                <Setter Property="BorderBrush" Value="#393C44"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Foreground" Value="#E0E1E6"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="GroupBox">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Border Background="#393C44"
                                Padding="8"
                                CornerRadius="2">
                                    <ContentPresenter ContentSource="Header"/>
                                </Border>
                                <Border Grid.Row="1"
                                BorderBrush="#393C44"
                                BorderThickness="1"
                                Padding="10">
                                    <ContentPresenter/>
                                </Border>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <!-- Buttons Menu STYLE -->
            <Style x:Key="MenuButtonNoHover" TargetType="Button">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderBrush" Value="Transparent"/>
                <Setter Property="Foreground" Value="WhiteSmoke"/>
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Padding" Value="10,8"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="HorizontalContentAlignment" Value="Left"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                                <ContentPresenter Margin="{TemplateBinding Padding}" VerticalAlignment="Center" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/HandyControl;component/Themes/SkinDefault.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/HandyControl;component/Themes/Theme.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesignTheme.Light.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesignTheme.Defaults.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
